# Set these in the shell before starting the commands (not embedded in the UI).
# npm run dev:device requires DEVICE_HOST. npm run dev:sim sets it automatically.
DEVICE_HOST=http://192.168.1.111
FRONTEND_PORT=5173
SIM_PORT=3080
SIM_CONTROL_PORT=3081
SIM_PROFILE=actuator
# Optional persistent simulator state, relative to interface/:
# SIM_STATE_FILE=.sim-state/actuator.json
# Optional control token; otherwise one is generated and printed locally:
# SIM_CONTROL_TOKEN=your-local-control-token
